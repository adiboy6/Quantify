{
  "manifest_version": 3,
  "name": "Quantify",
  "description": "Job autofill assistant",
  "version": "1.0",
  "action": {
    "default_popup": "index.html",
    "default_icon": "hello_extensions.png"
  },
  "content_scripts": [
    {
      "js": ["scripts/main.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "scripts/service_worker.js"
  },
  "permissions": ["storage", "cookies"],
  "host_permissions": ["<all_urls>"]
}
